<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorback"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnToggleServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/roundshapebtn"
            android:text="Настройки сервера"
            android:textColor="@color/colorButton"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutServerSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <!-- ... поля (MyMailIndex, Priznak_pmr, PORT_prm, PORT_prd, ip_server) ... -->
        </LinearLayout>

        <Button
            android:id="@+id/btnCodecDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/roundshapebtn"
            android:text="Режим передачи"
            android:textColor="@color/colorButton" />

        <Button
            android:id="@+id/btnChanList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/roundshapebtn"
            android:text="Список"
            android:textColor="@color/colorButton"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/roundshapebtn"
            android:text="Логи"
            android:textColor="@color/colorButton" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/roundshapebtn"
            android:text="СОХРАНИТЬ И ВЫЙТИ"
            android:textColor="@color/colorButton" />
    </LinearLayout>
</ScrollView>